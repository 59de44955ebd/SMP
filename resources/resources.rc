#include "windows.h"
#include "resources.h"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004
FILETYPE 0x1
{
BLOCK "StringFileInfo"
{
	BLOCK "040904B0"
	{
		VALUE "CompanyName", "59de44955ebd"
		VALUE "FileDescription", "SMP"
		VALUE "FileVersion", "0.2.0.0)"
		VALUE "InternalName", "SMP"
		VALUE "OriginalFilename", "SMP.exe"
		VALUE "ProductName", "SMP"
		VALUE "ProductVersion", "0,2,0,0"
	}
}

BLOCK "VarFileInfo"
{
	VALUE "Translation", 0x0409 0x04B0
}
}

1 ICON DISCARDABLE "app.ico"

IDB_TOOLBAR BITMAP DISCARDABLE "toolbar.bmp"
IDB_TOOLBAR_DARK BITMAP DISCARDABLE "toolbar-dark.bmp"
IDB_TOOLBAR_DISABLED BITMAP DISCARDABLE "toolbar-disabled.bmp"
IDB_VOLUME BITMAP DISCARDABLE "volume.bmp"
IDB_VOLUME_MUTE BITMAP DISCARDABLE "volume-mute.bmp"
IDB_VOLUME_DARK BITMAP DISCARDABLE "volume-dark.bmp"
IDB_VOLUME_MUTE_DARK BITMAP DISCARDABLE "volume-mute-dark.bmp"

IDB_CLOSE_BUTTON BITMAP DISCARDABLE "close-button.bmp"
IDB_CLOSE_BUTTON_DARK BITMAP DISCARDABLE "close-button-dark.bmp"

IDD_OPEN_URL DIALOGEX 0,0,296,60
CAPTION "Open URL"
FONT 8,"MS Shell Dlg",0,0,0
STYLE WS_POPUP|WS_VISIBLE|WS_CLIPSIBLINGS|WS_CAPTION|WS_SYSMENU|DS_MODALFRAME|DS_SETFONT|DS_3DLOOK
EXSTYLE WS_EX_CONTROLPARENT|WS_EX_WINDOWEDGE|WS_EX_DLGMODALFRAME
BEGIN
  CONTROL "&Please enter a URL:",-1,"Static",WS_CHILDWINDOW|WS_VISIBLE|WS_GROUP,7,7,115,8,WS_EX_NOPARENTNOTIFY
  CONTROL "",3,"Edit",WS_CHILDWINDOW|WS_VISIBLE|WS_GROUP|WS_TABSTOP|ES_AUTOHSCROLL,7,18,281,12,WS_EX_CLIENTEDGE|WS_EX_NOPARENTNOTIFY
  CONTROL "OK",IDOK,"Button",WS_CHILDWINDOW|WS_VISIBLE|WS_TABSTOP,185,39,50,14,WS_EX_NOPARENTNOTIFY
  CONTROL "Cancel",IDCANCEL,"Button",WS_CHILDWINDOW|WS_VISIBLE|WS_TABSTOP,239,39,50,14,WS_EX_NOPARENTNOTIFY
END

