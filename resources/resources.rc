IDD_ABOUT DIALOGEX 0,0,248,98
CAPTION "About"
FONT 8,"MS Shell Dlg",0,0,0
STYLE WS_POPUP|WS_VISIBLE|WS_CLIPSIBLINGS|WS_CAPTION|WS_SYSMENU|DS_MODALFRAME|DS_SETFONT|DS_3DLOOK
EXSTYLE WS_EX_CONTROLPARENT|WS_EX_WINDOWEDGE|WS_EX_TOPMOST|WS_EX_DLGMODALFRAME
BEGIN
  CONTROL "OK",1,"Button",WS_CHILDWINDOW|WS_VISIBLE|WS_GROUP|WS_TABSTOP,182,75,59,16,WS_EX_NOPARENTNOTIFY
  CONTROL "#1",128,"Static",WS_CHILDWINDOW|WS_VISIBLE|SS_ICON,12,8,32,32,WS_EX_NOPARENTNOTIFY
  CONTROL "SMP v0.2",11260,"Static",WS_CHILDWINDOW|WS_VISIBLE|WS_GROUP,46,8,182,9,WS_EX_NOPARENTNOTIFY
  CONTROL "<a>https://github.com/59de44955ebd/SMP</a>",22018,"SysLink",WS_CHILDWINDOW|WS_VISIBLE|WS_TABSTOP,46,17,182,9,WS_EX_NOPARENTNOTIFY
  CONTROL "A simple media player for Windows 11 that supports different multimedia frameworks/engines. UI inspired by MPC-HC and VLC.",-1,"Static",WS_CHILDWINDOW|WS_VISIBLE|WS_GROUP,9,39,236,25,WS_EX_NOPARENTNOTIFY
END

ID_POPUP_MENU_PLAYLIST MENU
BEGIN
  POPUP "Popup"
  BEGIN
    MENUITEM "&Import Playlist...", IDM_PLAYLIST_IMPORT
    MENUITEM "&Export Playlist...", IDM_PLAYLIST_EXPORT
    MENUITEM SEPARATOR
    MENUITEM "&Shuffle", IDM_PLAYLIST_SHUFFLE
    MENUITEM SEPARATOR
    MENUITEM "&Edit Title...", IDM_PLAYLIST_EDIT_TITLE
    MENUITEM "&Remove selected", IDM_PLAYLIST_REMOVE
    MENUITEM SEPARATOR
    MENUITEM "&Clear Playlist", IDM_PLAYLIST_CLEAR
  END
END
