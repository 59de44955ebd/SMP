  CONTROL "",IDC_CC_TRACKBAR_CONTRAST,"msctls_trackbar32",WS_CHILDWINDOW|WS_VISIBLE|WS_TABSTOP|TBS_NOTICKS,139,30,261,16,4
  CONTROL "",IDC_CC_TRACKBAR_HUE,"msctls_trackbar32",WS_CHILDWINDOW|WS_VISIBLE|WS_TABSTOP|TBS_NOTICKS,139,52,261,17,4
  CONTROL "",IDC_CC_TRACKBAR_SATURATION,"msctls_trackbar32",WS_CHILDWINDOW|WS_VISIBLE|WS_TABSTOP|TBS_NOTICKS,139,74,261,16,4
