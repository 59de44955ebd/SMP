  CONTROL "0",IDC_CC_STATIC_CONTRAST,"Static",WS_CHILDWINDOW|WS_VISIBLE|ES_CENTER,98,33,28,11,4
  CONTROL "0",IDC_CC_STATIC_HUE,"Static",WS_CHILDWINDOW|WS_VISIBLE|ES_CENTER,98,54,28,12,4
  CONTROL "0",IDC_CC_STATIC_SATURATION,"Static",WS_CHILDWINDOW|WS_VISIBLE|ES_CENTER,98,76,28,12,4
